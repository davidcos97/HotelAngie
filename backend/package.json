{
  "name": "6-14-coliving-backend",
  "version": "1.0.0",
  "private": true,
  "description": "6/14 Co-Living — API REST (Node.js + Express + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "4.19.2",
    "@prisma/client": "5.17.0",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "helmet": "7.1.0",
    "express-rate-limit": "7.4.0",
    "zod": "3.23.8",
    "dotenv": "16.4.5",
    "morgan": "1.10.0",
    "nodemailer": "6.9.14",
    "compression": "1.7.4"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "tsx": "4.16.5",
    "prisma": "5.17.0",
    "tsc-alias": "1.8.10",
    "@types/node": "20.14.12",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/morgan": "1.9.9",
    "@types/nodemailer": "6.4.15",
    "@types/compression": "1.7.5",
    "eslint": "8.57.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
